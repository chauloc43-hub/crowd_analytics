# Python environments and generated bytecode
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local configuration and operating-system files
.env
.env.*
!.env.example
Thumbs.db
*.log
*.tmp

# Data, evaluation, research, and development-only material
/dataset/
/test_data/
/tests/
/scripts/
/src/data/
/src/evaluation/
/src/training/
# Retained locally for historical experiments; the production runtime no longer imports it.
/src/tracking/ultralytics_reid_compat.py
*.ipynb
/requirements-reid.txt
/requirements-train-colab.txt

# Keep only the production FastTracker and classroom config surface.
/configs/*.yaml
/configs/experiments/
!/configs/pipeline-live.yaml
!/configs/fasttrack-live.yaml
!/configs/pipeline-classroom-template.yaml

# Model binaries and local evaluation artifacts are provisioned outside Git.
*.pt
*.pth
*.onnx
/artifacts/evaluation/
/artifacts/reid/
/artifacts/**/metrics.json
/runs/
/.ultralytics*/
.vercel
